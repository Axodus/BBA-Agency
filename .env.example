# Local development reference only. Copy to .env.local; never commit .env.local.
# Builds and containers do not load this file. Configure deployment values in
# Railway or another secret manager.

# API local development requires the rs0 replica set started by pnpm api:infra:up.
MONGODB_URI=mongodb://127.0.0.1:27017/bba-agency?replicaSet=rs0

# Private preview is disabled locally by default. Set true only when testing the
# private API access boundary with local, non-production values.
BBA_API_PRIVATE_PREVIEW=false
BBA_API_DEV_ACCESS_TOKEN=replace-with-a-local-secret
BBA_API_TENANT_ID=tenant-local
BBA_API_SUBJECT=steward-local
BBA_API_ACTOR_REFERENCE=person:steward-local
BBA_API_ALLOWED_ORIGINS=http://localhost:5173

# Optional. The API defaults to 3000 when PORT is absent.
# PORT=3000
