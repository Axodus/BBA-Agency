# Anthropic API
ANTHROPIC_API_KEY=sk-ant-

# MCP & Tools
FIGMA_ACCESS_TOKEN=
META_ADS_TOKEN=
NOTION_TOKEN=

# Database
# BBA API local development requires the rs0 replica set started by `pnpm api:infra:up`.
MONGODB_URI=mongodb://127.0.0.1:27017/bba-agency?replicaSet=rs0
CHROMA_URL=http://localhost:8001

# BBA API private preview only. Do not configure these for a public deployment.
BBA_API_PRIVATE_PREVIEW=false
BBA_API_DEV_ACCESS_TOKEN=
BBA_API_TENANT_ID=
BBA_API_SUBJECT=
BBA_API_ACTOR_REFERENCE=
BBA_API_ALLOWED_ORIGINS=http://localhost:5173

# Server
MCP_PORT=3100

# HITL & Intervention
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/
HITL_TIMEOUT_MINUTES=15

# Cost Control
MAX_TOKEN_COST_RATIO=0.05

# Mock LLM
USE_MOCK_LLM=true
AXODUS_MOCK_LLM=true

# Vector DB (Pinecone alternative)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east1-gcp

# Generated by MongoDB Atlas onboarding.
# This file contains sensitive credentials.
# DO NOT commit this file to version control.
# Store it securely (e.g. use a password manager or secrets vault).

MONGODB_USERNAME="atlas_db_user"
MONGODB_PASSWORD="<STRONG_PASSWORD>"
MONGODB_URI="mongodb+srv://atlas_db_user:<STRONG_PASSWORD>@bba-db-dev.98dm3s9.mongodb.net/?appName=bba-db-dev"