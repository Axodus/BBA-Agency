{
  "name": "@bba/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-ts -f openapi-ts.config.ts",
    "generate:check": "node tools/check-generated.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node tools/test-client-contract.mjs",
    "lint": "node ../../tools/workspace-quality-check.mjs --lint src/index.ts",
    "format:check": "node ../../tools/workspace-quality-check.mjs --format src/index.ts tools openapi-ts.config.ts",
    "check": "pnpm run generate:check && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  }
}
