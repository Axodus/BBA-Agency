{
  "name": "@bba/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme-script": "./src/theme/theme-script.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "node ../../tools/workspace-quality-check.mjs --lint src test",
    "format:check": "node ../../tools/workspace-quality-check.mjs --format src test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "react-router-dom": "7.18.1"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
