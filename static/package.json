{
  "name": "@bba/static-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm check:product-content && pnpm check:project-content && pnpm check:delivery-content && pnpm check:delivery-pages && pnpm check:project-pages",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node ../tools/workspace-quality-check.mjs --lint src",
    "format:check": "node ../tools/workspace-quality-check.mjs --format src",
    "check:product-content": "node tools/check-product-content.mjs",
    "check:project-content": "node tools/check-project-content.mjs",
    "generate:project-content": "node tools/generate-project-content.mjs",
    "generate:delivery-content": "node tools/generate-delivery-content.mjs",
    "check:delivery-content": "node tools/check-delivery-content.mjs",
    "check:delivery-pages": "node tools/check-delivery-pages.mjs",
    "capture:delivery-evidence": "node tools/capture-delivery-evidence.mjs",
    "capture:delivery-test-evidence": "node tools/capture-delivery-test-evidence.mjs",
    "assemble:delivery-test-evidence": "node tools/assemble-delivery-test-evidence.mjs",
    "check:delivery-test-evidence": "node tools/check-delivery-test-evidence.mjs",
    "check:project-pages": "node tools/check-project-pages.mjs",
    "capture:project-evidence": "node tools/capture-project-evidence.mjs",
    "capture:project-test-evidence": "PROJECT_EVIDENCE_ROOT=.rag/evidence/REQ-TEST-019-001 node tools/capture-project-evidence.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
