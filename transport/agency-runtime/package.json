{
  "name": "@bba/agency-runtime-http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "pnpm --filter @bba/publisher-prototype build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @bba/publisher-prototype build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && vitest run",
    "lint": "node ../../tools/workspace-quality-check.mjs --lint src test",
    "format:check": "node ../../tools/workspace-quality-check.mjs --format src test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "@bba/publisher-prototype": "workspace:*",
    "fastify": "5.10.0",
    "zod": "4.3.6"
  },
  "devDependencies": { "@types/node": "25.6.0", "typescript": "6.0.3", "vitest": "4.1.10" }
}
