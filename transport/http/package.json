{
  "name": "@bba/http-transport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../../core run build && tsc -p tsconfig.test.json && node --test --test-isolation=none .tmp/test/test/*.test.js",
    "lint": "node ../../tools/workspace-quality-check.mjs --lint src test",
    "format:check": "node ../../tools/workspace-quality-check.mjs --format src test tools",
    "architecture": "node tools/check-boundaries.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run format:check && pnpm run architecture"
  },
  "dependencies": {
    "@bba/platform-core": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "typescript": "6.0.3"
  }
}
